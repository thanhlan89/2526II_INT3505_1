{
  "info": {
    "_postman_id": "a1b2c3d4-week10-buoc1",
    "name": "INT3505 Week10 — Bước 1 (health / ready)",
    "description": "Import vào Postman. Chạy `python app.py` trong thư mục `demo/week10` trước khi gửi request.\n\nBiến `baseUrl` mặc định: http://127.0.0.1:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "GET / (root)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('service week10', () => pm.expect(j.service).to.eql('week10'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "GET /health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('status ok', () => pm.expect(j.status).to.eql('ok'));",
              "pm.test('có version', () => pm.expect(j).to.have.property('version'));",
              "pm.test('có env', () => pm.expect(j).to.have.property('env'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /ready",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 hoặc 503', () => pm.expect([200, 503]).to.include(pm.response.code));",
              "const j = pm.response.json();",
              "pm.test('có checks.database', () => pm.expect(j.checks).to.have.property('database'));",
              "if (pm.response.code === 200) {",
              "  pm.test('ready', () => pm.expect(j.status).to.eql('ready'));",
              "} else {",
              "  pm.test('not_ready khi DB lỗi', () => pm.expect(j.status).to.eql('not_ready'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ready"
      }
    }
  ]
}
