{
  "info": {
    "_postman_id": "a1b2c3d4-week10-buoc2",
    "name": "INT3505 Week10 — Bước 2 (logging + X-Request-ID)",
    "description": "Chạy server: `python app.py` trong `demo/week10`.\n\nKiểm tra console: mỗi request có log `http_access` (text hoặc JSON tùy LOG_JSON / APP_ENV).\n\nBiến collection `baseUrl`: http://127.0.0.1:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "echoRequestId",
      "value": "postman-test-00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "lastRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET /health — có header X-Request-ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const rid = pm.response.headers.get('X-Request-ID');",
              "pm.test('Response có X-Request-ID (UUID hoặc chuỗi client)', () => {",
              "  pm.expect(rid).to.be.a('string');",
              "  pm.expect(rid.length).to.be.above(0);",
              "});",
              "pm.collectionVariables.set('lastRequestId', rid);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /health — echo X-Request-ID từ client",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const sent = pm.collectionVariables.get('echoRequestId');",
              "const got = pm.response.headers.get('X-Request-ID');",
              "pm.test('Server trả lại đúng X-Request-ID đã gửi', () => pm.expect(got).to.eql(sent));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Request-ID",
            "value": "{{echoRequestId}}"
          }
        ],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /ready",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 hoặc 503', () => pm.expect([200, 503]).to.include(pm.response.code));",
              "pm.test('Có X-Request-ID', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
              "const j = pm.response.json();",
              "pm.test('có checks.database', () => pm.expect(j.checks).to.have.property('database'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ready"
      }
    }
  ]
}
